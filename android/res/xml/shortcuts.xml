<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: New chat, Live mode (the last chat is added at run time, see MainActivity.setLastChat). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ask Hermes: the small window. Declared as a sharing target so share sheets and drag trays that rank
         "direct share" targets can list it, and as a launcher shortcut for a quick question. -->
    <share-target android:targetClass="com.omarqaterge.hermesmobile.ShareDropActivity">
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="text/*" />
        <data android:mimeType="application/*" />
        <category android:name="com.omarqaterge.hermesmobile.category.ASK_HERMES" />
    </share-target>
    <shortcut
        android:shortcutId="ask_hermes"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_ask"
        android:shortcutLongLabel="@string/sc_ask">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.omarqaterge.hermesmobile"
            android:targetClass="com.omarqaterge.hermesmobile.ShareDropActivity" />
        <categories android:name="com.omarqaterge.hermesmobile.category.ASK_HERMES" />
    </shortcut>
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_new"
        android:shortcutLongLabel="@string/sc_new">
        <intent
            android:action="com.omarqaterge.hermesmobile.SHORTCUT"
            android:targetPackage="com.omarqaterge.hermesmobile"
            android:targetClass="com.omarqaterge.hermesmobile.MainActivity">
            <extra android:name="shortcut" android:value="new" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="live"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_live"
        android:shortcutLongLabel="@string/sc_live_long">
        <intent
            android:action="com.omarqaterge.hermesmobile.SHORTCUT"
            android:targetPackage="com.omarqaterge.hermesmobile"
            android:targetClass="com.omarqaterge.hermesmobile.MainActivity">
            <extra android:name="shortcut" android:value="live" />
        </intent>
    </shortcut>
</shortcuts>
